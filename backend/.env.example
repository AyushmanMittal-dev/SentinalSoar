# ════════════════════════════════════════════════════════════
# SENTINEL SOAR — Backend Environment Configuration
# ════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control.
# ════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# ── MongoDB ────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/sentinel-soar
MONGODB_DB_NAME=sentinel-soar

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

# ── JWT Secrets ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING_DO_NOT_USE_THIS_VALUE
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_HEX_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Google Gemini AI ───────────────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=10000
GEMINI_MAX_RETRIES=2

# ── VirusTotal ─────────────────────────────────────────────
# Get free key at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
VIRUSTOTAL_RATE_LIMIT_RPM=4

# ── AbuseIPDB ──────────────────────────────────────────────
# Get free key at: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=
ABUSEIPDB_BASE_URL=https://api.abuseipdb.com/api/v2
ABUSEIPDB_MAX_AGE_DAYS=90

# ── AlienVault OTX ─────────────────────────────────────────
# Get free key at: https://otx.alienvault.com
OTX_API_KEY=
OTX_BASE_URL=https://otx.alienvault.com/api/v1

# ── GeoIP (ip-api) — No key needed ────────────────────────
GEOIP_BASE_URL=http://ip-api.com/json
GEOIP_PRO_KEY=

# ── NVD CVE (Optional) ────────────────────────────────────
NVD_API_KEY=

# ── Email (SMTP) ───────────────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SentinelSOAR <noreply@sentinel.io>
SMTP_TIMEOUT_MS=5000

# ── Slack ──────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#security-alerts

# ── Discord ────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── File Storage ───────────────────────────────────────────
UPLOAD_DIR=./uploads/logs
REPORTS_DIR=./uploads/reports
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=.csv,.json,.log,.txt,.xml

# ── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_MAX=10

# ── Seeding ────────────────────────────────────────────────
SEED_ON_STARTUP=true
SEED_FORCE=false

# ── Feature Flags ──────────────────────────────────────────
FEATURE_MOCK_THREAT_INTEL=true
FEATURE_MOCK_AI=true
FEATURE_SIMULATION_DELAY=true
SIMULATION_DELAY_MS=150
FEATURE_DEMO_ENDPOINTS=true
