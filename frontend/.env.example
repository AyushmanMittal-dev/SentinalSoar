# ════════════════════════════════════════════════════════════
# SENTINEL SOAR — Frontend Environment Configuration
# ════════════════════════════════════════════════════════════
# Vite exposes only variables prefixed with VITE_ to the browser.
# NEVER put backend secrets here — these values are PUBLIC.
# ════════════════════════════════════════════════════════════

VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
VITE_APP_NAME=SentinelSOAR
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development
VITE_ENABLE_DEMO_FEATURES=true
VITE_DEFAULT_PAGE_SIZE=20
VITE_SOCKET_RECONNECT_ATTEMPTS=5
VITE_SOCKET_RECONNECT_DELAY_MS=2000
